# Gateway API auth. If unset the API runs UNAUTHENTICATED (local demo only).
SENTINEL_API_TOKEN=

# Vault key material. Vault refuses to operate unless both are set.
# Generate: openssl rand -hex 32
SENTINEL_VAULT_HMAC_KEY=
SENTINEL_VAULT_AES_KEY=

# Supervisor credential required for /api/v1/vault/detokenize
SENTINEL_SUPERVISOR_TOKEN=

# Trusted counterparty PGP public keyring (armored or binary).
# Without this, signature verification FAILS CLOSED.
SENTINEL_PGP_KEYRING=

# CORS origin for the operations UI
SENTINEL_ALLOWED_ORIGIN=http://localhost:3000
