# Sentinel Flow configuration. Copy to .env and fill in.
#
# Names and safe descriptions only. No credentials are committed here, and no
# value in this file is a working default.

# ---------------------------------------------------------------------------
# Profile: local-demo | production
#
# local-demo  binds loopback only, permits an unauthenticated API, and is
#             labelled as demo on every affected screen.
# production  refuses to start unless every setting below marked REQUIRED is
#             present. There are no defaults.
# ---------------------------------------------------------------------------
SENTINEL_PROFILE=local-demo

# Listen address. The local-demo profile refuses anything but loopback.
SENTINEL_BIND_ADDRESS=127.0.0.1
PORT=8080

# REQUIRED in production. Bearer token for the API. Minimum 32 characters, and
# well-known values such as "password" or "changeme" are rejected at startup.
# Generate: openssl rand -hex 32
SENTINEL_API_TOKEN=

# REQUIRED in production. Database location. In containers this must sit on the
# mounted volume, e.g. /app/data/sentinel.db
DATABASE_URL=

# REQUIRED in production. S3-compatible object storage endpoint.
OBJECT_STORE_URL=

# REQUIRED in production. Browser origin permitted by CORS.
SENTINEL_ALLOWED_ORIGIN=http://localhost:3000

# REQUIRED in production. Trusted counterparty PGP public keyring. Signature
# verification fails closed without it.
SENTINEL_PGP_KEYRING=

# Optional. Address of the AI analysis tier. When unset, AI endpoints report
# NOT_CONFIGURED; deterministic ingestion is unaffected.
AI_TIER_URL=

# Optional. Directory watched for inbound files.
SENTINEL_INBOX_PATH=./inbox

# ---------------------------------------------------------------------------
# Compose-only. Required by compose.yaml, which fails loudly if unset.
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Optional. Enables the AI tier's live model path. Absent, it reports
# UNAVAILABLE rather than generating an answer.
OPENAI_API_KEY=

# REQUIRED in production. Scrape credential for /metrics. Minimum 32 chars.
# A scraper is a machine with no tenant, so it gets its own credential rather
# than an OIDC identity.
SENTINEL_METRICS_TOKEN=

# Tenant the inbox watcher ingests into. When empty the watcher does not run.
# A daemon has no request and therefore no principal, so this is an explicit
# operator decision rather than a default.
SENTINEL_WATCHER_TENANT=

# PostgreSQL DSN used only by the row-level-security tests. When unset those
# tests skip and say so.
SENTINEL_TEST_POSTGRES_DSN=
